<%- include('partials/header',{title:''}) %>
<section class="home-hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><%= site.hero_badge || 'Compassionate cancer care' %></span>
      <h1><%= site.hero_title || 'Care today. Hope always.' %></h1>
      <p><%= site.hero_text || 'CSNF is dedicated to supporting people affected by cancer through awareness, early detection, treatment support and community care.' %></p>
      <div class="actions"><a class="btn primary" href="/donate">♡ Donate Now</a><a class="btn ghost-dark" href="/programs">Learn Our Programs →</a></div>
      <div class="hero-stats">
        <div class="stat-chip"><span class="stat-icon people">◎</span><div><strong><%= site.stat_lives || '48K+' %></strong><small>Lives Reached</small></div></div>
        <div class="stat-chip"><span class="stat-icon ribbon">◌</span><div><strong><%= site.stat_communities || '120+' %></strong><small>Communities</small></div></div>
        <div class="stat-chip"><span class="stat-icon heart">♡</span><div><strong><%= site.stat_volunteers || '450+' %></strong><small>Volunteers</small></div></div>
        <div class="stat-chip"><span class="stat-icon calendar">◫</span><div><strong><%= site.stat_events || '32+' %></strong><small>Events Held</small></div></div>
      </div>
    </div>
    <div class="hero-visual"><div class="hero-image-frame"><div class="hero-image-curve"></div><img src="<%= site.hero_image || '/images/placeholder-care.svg' %>" alt="Cancer support and compassionate care"></div></div>
  </div>
  <div class="wrap pillar-grid">
    <article class="pillar-card"><span class="pillar-icon pink">📣</span><h3>Awareness</h3><p>We educate and raise awareness to promote early detection.</p><span class="pillar-arrow">→</span></article>
    <article class="pillar-card"><span class="pillar-icon green">⚕</span><h3>Support</h3><p>We provide emotional, financial and practical support to patients and families.</p><span class="pillar-arrow">→</span></article>
    <article class="pillar-card"><span class="pillar-icon gold">✦</span><h3>Empower</h3><p>We empower survivors and communities to live healthier, stronger lives.</p><span class="pillar-arrow">→</span></article>
  </div>
</section>
<section class="intro wrap intro-polished"><div><span class="kicker">Who we are</span><h2>People first. Prevention forward. Hope always.</h2></div><div><p>CSNF is a not-for-profit cancer care initiative born out of compassion to support people affected by cancer. We work with survivors, health professionals, volunteers, communities and partners to reduce fear, encourage early detection and help families navigate the cancer journey.</p><a class="text-link" href="/about">Meet the foundation →</a></div></section>
<section class="section wrap"><div class="section-head"><div><span class="kicker">What we do</span><h2>Programs designed around real people.</h2></div><a class="text-link" href="/programs">View all programs →</a></div><div class="card-grid"><% programs.forEach((p,i)=>{ %><a class="card program-card" href="/programs/<%= p.slug %>"><div class="card-img" style="background-image:url('<%= p.image || '/images/placeholder-community.svg' %>')"><span class="card-num">0<%= i+1 %></span></div><div class="card-body"><h3><%= p.title %></h3><p><%= p.excerpt %></p><span>Learn more →</span></div></a><% }) %></div></section>
<section class="feature-story"><div class="feature-inner wrap"><div><span class="kicker light">Recent impact</span><h2>Care that becomes action.</h2><p>CSNF turns survivor-centered awareness into practical support for patients, families, hospitals and communities.</p><a class="btn light" href="/news">Read our latest news</a></div><div class="quote-card"><span>“</span><p>No one should face cancer alone. Every screening, every conversation and every act of support can become part of someone’s survival story.</p></div></div></section>
<section class="section wrap"><div class="section-head"><div><span class="kicker">Upcoming & recent</span><h2>Events that bring people together.</h2></div><a class="text-link" href="/events">All events →</a></div><div class="list-cards"><% events.forEach(e=>{ %><a href="/events/<%= e.slug %>" class="event-row"><div class="datebox"><b><%= new Date(e.event_date+'T00:00:00').toLocaleDateString('en-US',{day:'2-digit'}) %></b><span><%= new Date(e.event_date+'T00:00:00').toLocaleDateString('en-US',{month:'short'}) %></span></div><div><h3><%= e.title %></h3><p><%= e.location %></p></div><span class="arrow">↗</span></a><% }) %></div></section>
<section class="section soft"><div class="wrap"><div class="section-head"><div><span class="kicker">Stories & updates</span><h2>Hope deserves to be seen.</h2></div><a class="text-link" href="/stories">More stories →</a></div><div class="news-grid"><% [...stories,...news].slice(0,3).forEach((n)=>{ const type=n.person?'stories':'news'; %><a class="news-card" href="/<%= type %>/<%= n.slug %>"><img src="<%= n.image || '/images/placeholder-community.svg' %>" alt=""><div><small><%= n.person?'Story':'News' %></small><h3><%= n.title %></h3><p><%= n.excerpt %></p></div></a><% }) %></div></div></section>
<section class="cta wrap"><div><span class="kicker light">Make an impact</span><h2>Your support can become someone’s next chance.</h2></div><div><p>Donate, volunteer, sponsor a screening, invite CSNF to your community or partner with us on a program.</p><a class="btn light" href="/donate">Give today</a></div></section>
<%- include('partials/footer') %>
