<%- include('partials/header',{title:item.title}) %>
<%
const fallbacks={programs:'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1800&q=88',events:'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1800&q=88',news:'https://images.unsplash.com/photo-1471864190281-a93a3070b6de?auto=format&fit=crop&w=1800&q=88',stories:'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1800&q=88'};
const fallback=fallbacks[type]||fallbacks.news;
const meta=item.location||item.person||item.published_at||item.event_date||'Cancer Support Network Foundation';
%>
<article class="wrap detail-pro-hero"><div class="detail-pro-image"><img src="<%= item.image||fallback %>" onerror="this.onerror=null;this.src='<%= fallback %>'" alt="<%= item.title %>"><div class="detail-pro-title"><span class="pro-eyebrow" style="color:#f0cf80"><%= type.slice(0,-1) %></span><h1><%= item.title %></h1><p><%= meta %></p></div></div></article>
<section class="wrap detail-pro-body"><div class="detail-pro-content"><p class="lead"><%= item.excerpt %></p><p><%= item.body %></p></div><aside class="detail-pro-aside"><span class="pro-eyebrow">Get involved</span><h3>Help us do more.</h3><p>Support awareness, screening, patient-centered care and survivorship programs across Ghana.</p><a class="pro-btn rose" href="/donate">Support CSNF ↗</a><p style="margin-top:18px"><a class="pro-link" href="/<%= type %>">← Back to <%= type %></a></p></aside></section>
<%- include('partials/footer') %>
