<%- include('partials/header',{title:type.charAt(0).toUpperCase()+type.slice(1)}) %>
<%
const config={
programs:{label:'Programs',title:'Support designed around real needs.',copy:'Explore the programs CSNF uses to strengthen awareness, early detection, patient care and survivorship.',hero:'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1600&q=88'},
events:{label:'Events',title:'Moments that bring community together.',copy:'From screening outreach to survivor gatherings, our events turn awareness into connection and action.',hero:'https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1600&q=88'},
news:{label:'News & impact',title:'Updates from the work.',copy:'Follow CSNF initiatives, partnerships, donations, campaigns and community impact across Ghana.',hero:'https://images.unsplash.com/photo-1471864190281-a93a3070b6de?auto=format&fit=crop&w=1600&q=88'},
stories:{label:'Stories',title:'Hope deserves to be seen.',copy:'Read stories that celebrate courage, survivorship, community and the people behind the cancer journey.',hero:'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1600&q=88'}
};
const c=config[type]||config.news;
const fallbacks=['https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=1200&q=86','https://images.unsplash.com/photo-1494386346843-e12284507169?auto=format&fit=crop&w=1200&q=86','https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=86','https://images.unsplash.com/photo-1538108149393-fbbd81895907?auto=format&fit=crop&w=1200&q=86'];
%>
<section class="pro-page-hero"><div class="wrap pro-page-hero-grid"><div class="pro-page-hero-copy"><span class="pro-eyebrow"><%= c.label %></span><h1><%= c.title %></h1><p><%= c.copy %></p></div><div class="pro-page-hero-media"><img src="<%= c.hero %>" alt="<%= c.label %>"></div></div></section>
<section class="pro-section wrap"><div class="listing-grid"><% items.forEach((item,i)=>{ const fallback=fallbacks[i%fallbacks.length]; const meta=item.event_date||item.published_at||item.person||'CSNF'; %><a class="listing-card <%= i===0?'featured':'' %>" href="/<%= type %>/<%= item.slug %>"><img src="<%= item.image||fallback %>" onerror="this.onerror=null;this.src='<%= fallback %>'" alt="<%= item.title %>"><div class="body"><small><%= meta %></small><h3><%= item.title %></h3><p><%= item.excerpt %></p><b>Read more ↗</b></div></a><% }) %></div></section>
<section class="pro-cta wrap"><div><span class="pro-eyebrow" style="color:#f6dce6">Get involved</span><h2>Help us take care further.</h2></div><div><p>Support outreach, screening, patient care and survivorship through a donation or partnership.</p><div class="pro-actions"><a class="pro-btn light" href="/donate">Donate now ↗</a><a class="pro-btn" style="border:1px solid rgba(255,255,255,.45);color:#fff" href="/contact">Partner with us</a></div></div></section>
<%- include('partials/footer') %>
