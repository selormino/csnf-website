<%- include('partials/header',{title:type.charAt(0).toUpperCase()+type.slice(1)}) %><section class="page-hero"><div class="wrap"><span class="kicker"><%= type %></span><h1><%= type==='news'?'News & impact':type==='stories'?'Stories of hope':type==='events'?'Events & outreach':'Programs & support' %></h1><p>Explore the work, people and moments shaping our mission to fight cancer together.</p></div></section><section class="section wrap"><div class="news-grid wide"><% items.forEach(item=>{ %><a class="news-card" href="/<%= type %>/<%= item.slug %>"><img src="<%= item.image %>" alt=""><div><small><%= item.event_date||item.published_at||item.person||'CSNF' %></small><h3><%= item.title %></h3><p><%= item.excerpt %></p></div></a><% }) %></div></section><%- include('partials/footer') %>
