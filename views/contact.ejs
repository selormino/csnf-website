<%- include('partials/header',{title:'Contact'}) %>
<section class="pro-page-hero"><div class="wrap pro-page-hero-grid"><div class="pro-page-hero-copy"><span class="pro-eyebrow">Contact</span><h1>Let’s bring support closer.</h1><p>Volunteer, partner, sponsor an outreach, invite CSNF to speak or ask how you can support a patient or family.</p></div><div class="pro-page-hero-media"><img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1600&q=88" alt="People collaborating and connecting"></div></div></section>
<section class="wrap contact-pro"><aside class="contact-info-pro"><span class="pro-eyebrow" style="color:#e9c970">Reach us</span><h2>We’re here to help.</h2><p>Whether you need information, want to volunteer or are exploring a partnership, start the conversation with our team.</p><div class="contact-method"><small>Email</small><a href="mailto:<%= site.email %>"><%= site.email %></a></div><div class="contact-method"><small>Phone</small><a href="tel:<%= String(site.phone||'').replace(/\s+/g,'') %>"><%= site.phone %></a></div><div class="contact-method"><small>Location</small><span><%= site.address %></span></div></aside><form class="contact-form-pro" method="post"><span class="pro-eyebrow">Send a message</span><h2>Tell us how we can help.</h2><% if(typeof sent!=='undefined'&&sent){ %><div class="contact-success">Thanks — your message has been received.</div><% } %><label>Name<input name="name" required placeholder="Your full name"></label><label>Email<input name="email" type="email" required placeholder="you@example.com"></label><label>Message<textarea name="message" rows="7" required placeholder="Tell us what you need or how you would like to get involved."></textarea></label><button class="pro-btn rose" type="submit">Send message ↗</button></form></section>
<section class="pro-section soft"><div class="wrap"><div class="pro-heading"><div><span class="pro-eyebrow">Ways to connect</span><h2>There is more than one way to make an impact.</h2></div></div><div class="contact-options"><article class="contact-option"><h3>Volunteer</h3><p>Give your time, skills or professional expertise to support CSNF programs and events.</p></article><article class="contact-option"><h3>Partner</h3><p>Work with CSNF on screenings, community education, sponsorship or patient support.</p></article><article class="contact-option"><h3>Invite us</h3><p>Bring a cancer awareness conversation, survivor story or outreach activity to your community.</p></article></div></div></section>
<%- include('partials/footer') %>
