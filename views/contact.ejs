<%- include('partials/header',{title:'Contact'}) %><section class="page-hero"><div class="wrap"><span class="kicker">Contact</span><h1>Bring the mission closer to your community.</h1><p>Volunteer, partner, sponsor an outreach, invite CSNF to speak or ask how you can support a patient.</p></div></section><section class="section wrap contact-grid"><div><h2>Let’s connect.</h2><p><b>Email</b><br><%= site.email %></p><p><b>Phone</b><br><%= site.phone %></p><p><b>Location</b><br><%= site.address %></p></div><form class="contact-form" method="post"><% if(typeof sent!=='undefined'&&sent){ %><div class="success">Thanks — your message has been received.</div><% } %><label>Name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Message<textarea name="message" rows="6" required></textarea></label><button class="btn primary">Send message</button></form></section><%- include('partials/footer') %>
