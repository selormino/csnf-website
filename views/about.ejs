<%- include('partials/header',{title:'About'}) %>
<%
const hero='https://images.unsplash.com/photo-1559757175-0eb30cd8c063?auto=format&fit=crop&w=1600&q=88';
const story='https://images.unsplash.com/photo-1559027615-cd4628902d4a?auto=format&fit=crop&w=1400&q=88';
const people=['https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=900&q=86','https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=900&q=86','https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=900&q=86'];
%>
<section class="pro-page-hero"><div class="wrap pro-page-hero-grid"><div class="pro-page-hero-copy"><span class="pro-eyebrow">About CSNF</span><h1>Compassion turned into a movement.</h1><p>Since 2018, Cancer Support Network Foundation has helped make cancer information, support and survivorship more visible and more human across Ghana.</p></div><div class="pro-page-hero-media"><img src="<%= hero %>" alt="Cancer support and compassionate care"></div></div></section>

<section class="pro-section wrap about-story"><div><img src="<%= story %>" alt="Community volunteers working together"></div><div><span class="pro-eyebrow">Our story</span><h2>We exist so people do not have to navigate cancer alone.</h2><p>CSNF was born out of compassion to care for and support people affected by cancer. Our work brings together awareness, screening outreach, patient assistance, survivor celebrations and advocacy for stronger cancer care.</p><p>We believe outcomes improve when people understand warning signs, act earlier, receive practical support during treatment and see survivorship represented with dignity and hope.</p><a class="pro-link" href="/programs">Explore our programs <span>↗</span></a></div></section>

<section class="pro-section soft"><div class="wrap"><div class="pro-heading"><div><span class="pro-eyebrow">What guides us</span><h2>A mission built on dignity, access and hope.</h2></div></div><div class="about-values"><article class="value-panel"><span>01</span><h3>Awareness</h3><p>We make cancer information clear, culturally relevant and easier to act on.</p></article><article class="value-panel"><span>02</span><h3>Access</h3><p>We bring screening, education and support closer to communities that need them.</p></article><article class="value-panel"><span>03</span><h3>Survivorship</h3><p>We amplify survivor voices and build spaces where courage, recovery and hope are visible.</p></article></div></div></section>

<section class="pro-section wrap"><div class="pro-heading"><div><span class="pro-eyebrow">Leadership</span><h2>People behind the mission.</h2></div></div><div class="team-grid-pro"><% team.forEach((m,i)=>{ const fallback=people[i%people.length]; %><article class="team-pro"><img src="<%= m.image||fallback %>" onerror="this.onerror=null;this.src='<%= fallback %>'" alt="<%= m.name %>"><div class="body"><h3><%= m.name %></h3><span class="role"><%= m.role %></span><p><%= m.bio %></p></div></article><% }) %></div></section>

<section class="pro-cta wrap"><div><span class="pro-eyebrow" style="color:#f6dce6">Stand with us</span><h2>Together, support reaches further.</h2></div><div><p>Volunteer, partner, sponsor an outreach or support a patient through CSNF.</p><div class="pro-actions"><a class="pro-btn light" href="/contact">Get involved ↗</a><a class="pro-btn" style="border:1px solid rgba(255,255,255,.45);color:#fff" href="/donate">Donate</a></div></div></section>
<%- include('partials/footer') %>
