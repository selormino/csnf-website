<%- include('_head',{title:'Dashboard'}) %><div class="admin-shell"><%- include('_sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Content Studio</small><h1>Good to see you.</h1><p>Everything you need to keep the CSNF website fresh.</p></div><a class="new-btn" href="/admin/news/new">+ New post</a></div><div class="metric-grid"><% Object.entries(counts).forEach(([k,v])=>{ %><a href="/admin/<%= k %>" class="metric"><span><%= k %></span><strong><%= v %></strong><small>Manage content →</small></a><% }) %></div><section class="panel"><div class="panel-head"><h2>Recently updated</h2></div><table><thead><tr><th>Type</th><th>Title</th><th>Updated</th></tr></thead><tbody><% recent.forEach(r=>{ %><tr><td><span class="tag"><%= r.type %></span></td><td><%= r.title %></td><td><%= r.updated_at %></td></tr><% }) %></tbody></table></section></main></div></body></html>
