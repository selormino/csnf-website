<%- include('_head',{title:'Settings'}) %><div class="admin-shell"><%- include('_sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Website configuration</small><h1>Site settings</h1><p>Update organization details and homepage messaging without code changes.</p></div></div><form class="settings-form" method="post"><section class="panel form-panel"><h2>Brand & homepage</h2><label>Site name<input name="site_name" value="<%= values.site_name||'' %>"></label><label>Tagline<input name="tagline" value="<%= values.tagline||'' %>"></label><label>Hero title<input name="hero_title" value="<%= values.hero_title||'' %>"></label><label>Hero text<textarea name="hero_text" rows="4"><%= values.hero_text||'' %></textarea></label></section><section class="panel form-panel"><h2>Contact & donations</h2><div class="two"><label>Phone<input name="phone" value="<%= values.phone||'' %>"></label><label>Email<input name="email" value="<%= values.email||'' %>"></label></div><label>Address<input name="address" value="<%= values.address||'' %>"></label><label>Mobile Money<input name="momo" value="<%= values.momo||'' %>"></label><div class="two"><label>Zelle<input name="zelle" value="<%= values.zelle||'' %>"></label><label>Cash App<input name="cashapp" value="<%= values.cashapp||'' %>"></label></div><label>LinkedIn<input name="linkedin" value="<%= values.linkedin||'' %>"></label></section><button class="save big">Save settings</button></form></main></div></body></html>
