<%- include('_head',{title:type}) %><div class="admin-shell"><%- include('_sidebar') %><main class="admin-main"><div class="admin-top"><div><small>Manage content</small><h1><%= type.charAt(0).toUpperCase()+type.slice(1) %></h1><p>Create, update, publish or remove items.</p></div><a class="new-btn" href="/admin/<%= type %>/new">+ Add <%= type==='news'?'post':type.slice(0,-1) %></a></div><section class="panel"><table><thead><tr><th>Title</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody><% items.forEach(item=>{ %><tr><td><b><%= item.title||item.name %></b><% if(item.role){ %><small class="sub"><%= item.role %></small><% } %></td><td><span class="status <%= item.published?'live':'draft' %>"><%= item.published?'Published':'Draft' %></span></td><td><%= item.updated_at||'' %></td><td class="actions-cell"><a href="/admin/<%= type %>/<%= item.id %>/edit">Edit</a><form action="/admin/<%= type %>/<%= item.id %>/delete" method="post" onsubmit="return confirm('Delete this item?')"><button>Delete</button></form></td></tr><% }) %><% if(!items.length){ %><tr><td colspan="4" class="empty">No content yet.</td></tr><% } %></tbody></table></section></main></div></body></html>
