<%- include('_head',{title:(isNew?'New ':'Edit ')+type}) %>
<div class="admin-shell"><%- include('_sidebar') %><main class="admin-main">
<div class="admin-top"><div><small><a href="/admin/<%= type %>">← Back to <%= type %></a></small><h1><%= isNew?'Create':'Edit' %> <%= type==='news'?'news post':type.slice(0,-1) %></h1><p>Content changes appear on the public website as soon as you save.</p></div></div>
<form class="editor" method="post" action="<%= isNew?'/admin/'+type:'/admin/'+type+'/'+item.id %>" enctype="multipart/form-data">
<div class="editor-main">
<% if(type==='team'){ %>
<label>Name<input name="name" value="<%= item.name||'' %>" required></label>
<label>Role<input name="role" value="<%= item.role||'' %>"></label>
<label>Bio<textarea name="bio" rows="7"><%= item.bio||'' %></textarea></label>
<%- include('_image_upload',{item}) %>
<label>Sort order<input type="number" name="sort_order" value="<%= item.sort_order||0 %>"></label>
<% } else { %>
<label>Title<input name="title" value="<%= item.title||'' %>" required></label>
<label>Slug <small>leave blank to auto-generate</small><input name="slug" value="<%= item.slug||'' %>"></label>
<% if(type==='stories'){ %><label>Person / attribution<input name="person" value="<%= item.person||'' %>"></label><% } %>
<% if(type==='events'){ %><div class="two"><label>Event date<input type="date" name="event_date" value="<%= item.event_date||'' %>"></label><label>Location<input name="location" value="<%= item.location||'' %>"></label></div><% } %>
<% if(type==='news'){ %><label>Publish date<input type="date" name="published_at" value="<%= item.published_at||'' %>"></label><% } %>
<label>Summary<textarea name="excerpt" rows="3"><%= item.excerpt||'' %></textarea></label>
<label>Full content<textarea name="body" rows="10"><%= item.body||'' %></textarea></label>
<%- include('_image_upload',{item}) %>
<% } %>
</div>
<aside class="publish-box"><h3>Publishing</h3><label class="check"><input type="checkbox" name="published" <%= item.published?'checked':'' %>> Published</label><% if(type!=='team'){ %><label class="check"><input type="checkbox" name="featured" <%= item.featured?'checked':'' %>> Feature this item</label><% } %><button class="save"><%= isNew?'Publish item':'Save changes' %></button><a href="/admin/<%= type %>">Cancel</a></aside>
</form>
</main></div><script src="/js/admin.js"></script></body></html>
