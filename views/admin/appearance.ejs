<%- include('_head',{title:'Appearance'}) %>
<div class="admin-shell"><%- include('_sidebar') %><main class="admin-main">
<div class="admin-top"><div><small>WordPress-style customization</small><h1>Appearance & themes</h1><p>Switch the public site look without touching code.</p></div></div>
<form class="settings-form wide-settings" method="post" enctype="multipart/form-data">
<section class="panel form-panel"><div class="panel-copy"><h2>Choose a theme</h2><p>Each theme changes typography, colors, hero composition, cards, and section styling.</p></div>
<div class="theme-grid">
<% const themes=[
{id:'hope',name:'Hope',desc:'Warm, polished and closest to your reference design.',colors:['#0b6258','#cf2e6c','#fff5f7']},
{id:'emerald',name:'Emerald',desc:'Premium editorial look with deeper greens and elegant spacing.',colors:['#113b34','#b8893f','#f5f1e8']},
{id:'aurora',name:'Aurora',desc:'Fresh, modern and brighter with soft gradients and glass cards.',colors:['#4b3f93','#ef4d88','#eaf8ff']},
{id:'classic',name:'Classic',desc:'Timeless nonprofit style with serif typography and restrained color.',colors:['#23313a','#9d3153','#f7f3ed']}
]; %>
<% themes.forEach(t=>{ %><label class="theme-card <%= (values.theme||'hope')===t.id?'selected':'' %>" data-theme-option><input type="radio" name="theme" value="<%= t.id %>" <%= (values.theme||'hope')===t.id?'checked':'' %>><div class="theme-preview"><% t.colors.forEach(c=>{ %><i style="background:<%= c %>"></i><% }) %></div><strong><%= t.name %></strong><span><%= t.desc %></span></label><% }) %>
</div></section>
<section class="panel form-panel"><h2>Brand styling</h2><div class="two"><label>Accent color<input type="color" name="accent_color" value="<%= values.accent_color||'#cf2e6c' %>" class="color-input"></label><label>Card style<select name="card_style"><option value="soft" <%= values.card_style==='soft'?'selected':'' %>>Soft shadow</option><option value="glass" <%= values.card_style==='glass'?'selected':'' %>>Glass</option><option value="outline" <%= values.card_style==='outline'?'selected':'' %>>Minimal outline</option></select></label></div><label>Hero eyebrow text<input name="hero_badge" value="<%= values.hero_badge||'Compassionate cancer care' %>"></label></section>
<section class="panel form-panel"><h2>Hero image</h2><p class="helper">Drag a new image in or click to browse. You can also paste a hosted image URL.</p><div class="dropzone"><input type="file" name="hero_image_file" accept="image/*" hidden><div class="upload-preview"><% if(values.hero_image){ %><img src="<%= values.hero_image %>" alt="Hero image"><span>Current hero image</span><% } %></div><div class="drop-copy"><strong>Drop hero image here</strong><span>or</span><button type="button" class="secondary-btn" data-choose-file>Choose image</button></div></div><label>Hero image URL<input name="hero_image" value="<%= values.hero_image||'' %>" placeholder="/images/placeholder-care.svg"></label></section>
<section class="panel form-panel"><h2>Logo</h2><p class="helper">Optional. Leave empty to use the built-in CSNF mark.</p><div class="dropzone compact-drop"><input type="file" name="logo_image_file" accept="image/*" hidden><div class="upload-preview"><% if(values.logo_image){ %><img src="<%= values.logo_image %>" alt="Logo"><span>Current logo</span><% } %></div><div class="drop-copy"><strong>Drop logo here</strong><span>or</span><button type="button" class="secondary-btn" data-choose-file>Choose logo</button></div></div><label>Logo image URL<input name="logo_image" value="<%= values.logo_image||'' %>"></label></section>
<button class="save big">Save appearance</button>
</form></main></div><script src="/js/admin.js"></script></body></html>
