<%- include('_head',{title:'Appearance'}) %>
<div class="admin-shell"><%- include('_sidebar') %><main class="admin-main">
<div class="admin-top"><div><small>Design system</small><h1>Appearance & themes</h1><p>Switch the public site mood, brand accent and hero imagery without touching code.</p></div></div>
<form class="settings-form wide-settings" method="post" enctype="multipart/form-data">
<section class="panel form-panel"><div class="panel-copy"><h2>Choose a theme</h2><p>Each theme changes the site color system while keeping the same polished layout and responsive behavior.</p></div>
<div class="theme-grid">
<% const themes=[
{id:'hope',name:'Hope',desc:'Warm forest, rose and cream — compassionate and contemporary.',colors:['#0e4b3f','#c63d6d','#f4efe7']},
{id:'emerald',name:'Emerald',desc:'Premium deep green with a refined gold accent.',colors:['#173f36','#b8893f','#f2eee4']},
{id:'aurora',name:'Aurora',desc:'Modern violet and pink with a brighter editorial feel.',colors:['#433a86','#ef4d88','#f1efff']},
{id:'classic',name:'Classic',desc:'Timeless charcoal, wine and warm neutral tones.',colors:['#293841','#9d3153','#f3eee6']}
]; %>
<% themes.forEach(t=>{ %><label class="theme-card <%= (values.theme||'hope')===t.id?'selected':'' %>" data-theme-option><input type="radio" name="theme" value="<%= t.id %>" <%= (values.theme||'hope')===t.id?'checked':'' %>><div class="theme-preview"><% t.colors.forEach(c=>{ %><i style="background:<%= c %>"></i><% }) %></div><strong><%= t.name %></strong><span><%= t.desc %></span></label><% }) %>
</div></section>
<section class="panel form-panel"><h2>Brand styling</h2><div class="two"><label>Accent color<input type="color" name="accent_color" value="<%= values.accent_color||'#c63d6d' %>" class="color-input"></label><label>Card style<select name="card_style"><option value="soft" <%= values.card_style==='soft'?'selected':'' %>>Soft shadow</option><option value="glass" <%= values.card_style==='glass'?'selected':'' %>>Glass</option><option value="outline" <%= values.card_style==='outline'?'selected':'' %>>Minimal outline</option></select></label></div><label>Hero eyebrow text<input name="hero_badge" value="<%= values.hero_badge||'Cancer support • Ghana' %>"></label></section>
<section class="panel form-panel"><h2>Hero image</h2><p class="helper">Drop a new photo here or click to browse. If no reliable image is set, the public site automatically uses a professional web-hosted photograph.</p><div class="dropzone"><input type="file" name="hero_image_file" accept="image/*" hidden><div class="upload-preview"><img src="<%= values.hero_image||'https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1000&q=82' %>" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1000&q=82'" alt="Hero image"><span>Current hero image</span></div><div class="drop-copy"><strong>Drop hero image here</strong><span>or</span><button type="button" class="secondary-btn" data-choose-file>Choose image</button></div></div><label>Hero image URL<input name="hero_image" value="<%= values.hero_image||'' %>" placeholder="https://images.unsplash.com/..."></label></section>
<section class="panel form-panel"><h2>Logo</h2><p class="helper">Optional. Leave empty to use the built-in CSNF brand mark.</p><div class="dropzone compact-drop"><input type="file" name="logo_image_file" accept="image/*" hidden><div class="upload-preview"><% if(values.logo_image){ %><img src="<%= values.logo_image %>" alt="Logo"><span>Current logo</span><% } %></div><div class="drop-copy"><strong>Drop logo here</strong><span>or</span><button type="button" class="secondary-btn" data-choose-file>Choose logo</button></div></div><label>Logo image URL<input name="logo_image" value="<%= values.logo_image||'' %>"></label></section>
<button class="save big">Save appearance</button>
</form></main></div><script src="/js/admin.js"></script></body></html>
